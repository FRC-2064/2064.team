---
import { getDocsUrl } from '../data/site';

const docsUrl = getDocsUrl(import.meta.env.DEV);

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/robots/', label: 'Robots' },
  { href: '/events/', label: 'Events' },
  { href: '/sponsors/', label: 'Sponsors' },
  { href: '/media/', label: 'Media' },
  { href: docsUrl, label: 'Docs', external: true, newTab: false }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-30 border-b border-black/10 bg-white">
  <div class="absolute inset-x-0 top-0 h-[3px] bg-brand-red"></div>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a href="/" class="group inline-flex items-center" aria-label="2064 The Panther Project home">
      <img
        src="/brand/wordmark.png"
        alt="Panther Project 2064"
        class="h-9 object-contain transition group-hover:opacity-85 sm:h-10"
        height="40"
      />
    </a>

    <div class="flex items-center gap-1 text-xs font-black uppercase tracking-wider sm:gap-2">
      {navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const isActive = !item.external && itemPath === currentPath;
        if (isActive) {
          return (
            <a
              href={item.href}
              aria-current="page"
              class="relative px-3 py-2 text-brand-red sm:px-4"
            >
              {item.label}
              <span class="absolute -bottom-px left-3 right-3 h-[3px] rounded-full bg-brand-red sm:left-4 sm:right-4"></span>
            </a>
          );
        }
        return (
          <a
            href={item.href}
            target={item.newTab ? '_blank' : undefined}
            rel={item.newTab ? 'noreferrer' : undefined}
            class="rounded-full px-3 py-2 text-brand-charcoal transition hover:bg-brand-red hover:text-white sm:px-4"
          >
            {item.label}
          </a>
        );
      })}
    </div>
  </nav>
</header>
