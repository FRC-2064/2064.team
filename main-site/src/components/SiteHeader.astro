---
const navItems = [
  { href: '/', label: 'Home' },
  { href: '/robots/', label: 'Robots' },
  { href: '/events/', label: 'Events' },
  { href: '/sponsors/', label: 'Sponsors' }
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-30 border-b border-black/10 bg-white/85 backdrop-blur supports-[backdrop-filter]:bg-white/70">
  <div class="absolute inset-x-0 top-0 h-[3px] bg-brand-red"></div>
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-3 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <a href="/" class="group flex items-center gap-3" aria-label="2064 The Panther Project home">
      <img
        src="/brand/logo.png"
        alt="2064 The Panther Project"
        class="h-11 w-11 object-contain transition group-hover:scale-105"
        width="44"
        height="44"
      />
      <img
        src="/brand/wordmark.png"
        alt="Panther Project 2064"
        class="hidden h-7 object-contain sm:block"
        height="28"
      />
    </a>

    <div class="flex items-center gap-1 text-xs font-black uppercase tracking-wider sm:gap-2">
      {navItems.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const isActive = itemPath === currentPath;
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class:list={[
              'relative rounded-full px-3 py-2 transition sm:px-4',
              isActive
                ? 'bg-brand-black text-white'
                : 'text-brand-charcoal hover:bg-brand-red hover:text-white'
            ]}
          >
            {item.label}
            {isActive && (
              <span class="absolute -bottom-[6px] left-1/2 h-1 w-6 -translate-x-1/2 rounded-full bg-brand-red"></span>
            )}
          </a>
        );
      })}
    </div>
  </nav>
</header>
