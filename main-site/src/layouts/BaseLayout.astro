---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_TITLE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_TITLE,
  description = 'Official website for FRC Team 2064, The Panther Project.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-brand-black antialiased">
    <SiteHeader />
    <div
      id="site-notice"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 px-4"
      role="dialog"
      aria-modal="true"
      aria-labelledby="site-notice-title"
      aria-describedby="site-notice-copy"
    >
      <div class="w-full max-w-lg rounded-3xl border border-white/10 bg-white p-8 text-center shadow-2xl sm:p-10">
        <p class="t-eyebrow text-brand-red">Notice</p>
        <h2 id="site-notice-title" class="t-h2 mt-4 text-3xl text-brand-black sm:text-4xl">
          This site is a work in progress.
        </h2>
        <p id="site-notice-copy" class="t-body mt-4 text-black/65">
          Some pages and content are still being updated. Please continue only if you understand that parts of the site may be incomplete.
        </p>
        <button
          id="site-notice-accept"
          type="button"
          class="mt-8 inline-flex min-w-36 items-center justify-center rounded-full bg-brand-red px-6 py-3 text-sm font-black uppercase tracking-[0.18em] text-white transition hover:bg-brand-red-deep"
        >
          Accept
        </button>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      const notice = document.getElementById('site-notice');
      const accept = document.getElementById('site-notice-accept');
      const storageKey = 'site-notice-accepted';

      const dismissNotice = () => {
        if (!notice) return;
        notice.style.display = 'none';
        document.body.style.overflow = '';
      };

      if (localStorage.getItem(storageKey) === 'true') {
        dismissNotice();
      } else {
        document.body.style.overflow = 'hidden';
        accept?.addEventListener('click', () => {
          localStorage.setItem(storageKey, 'true');
          dismissNotice();
        });
      }
    </script>
  </body>
</html>
