---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { SITE_TITLE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_TITLE,
  description = 'Official website for FRC Team 2064, The Panther Project.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-brand-black antialiased">
    <SiteHeader />
    <div class="border-b border-black/10 bg-brand-bone">
      <div class="mx-auto max-w-7xl px-4 py-3 text-center sm:px-6 lg:px-8">
        <p class="t-subscript font-medium uppercase tracking-[0.18em] text-brand-charcoal">
          This site is a work in progress.
        </p>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
