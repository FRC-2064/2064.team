---
import BaseLayout from '../layouts/BaseLayout.astro';
import M3Button from '../components/M3Button.astro';
import { sponsors } from '../data/site';

const pillars = [
  { 
    eyebrow: 'Technical Mastery', 
    title: 'Engineering & Fabrication', 
    body: 'Students gain hands-on experience operating industry-standard shop machinery—including CNC routers, metal lathes, milling machines, and 3D printers—while designing competition robots using Onshape.' 
  },
  { 
    eyebrow: 'Software & Controls', 
    title: 'Programming & Robotics', 
    body: 'Our software team writes robust Java code using WPILib, implements advanced autonomous navigation and vision tracking pipelines, and builds custom microcontroller systems.' 
  },
  { 
    eyebrow: 'Gracious Professionalism', 
    title: 'Community & Leadership', 
    body: 'Beyond building 125-pound competition robots, team members develop real-world skills in project management, public speaking, safety certification, and community outreach.' 
  }
];

const galleryTiles = [
  { label: 'Shop Machining & Fabrication', span: 'lg:col-span-2 lg:row-span-2 aspect-square lg:aspect-auto' },
  { label: 'Robot Design & CAD', span: 'aspect-[4/3]' },
  { label: 'Electrical & Controls Integration', span: 'aspect-[4/3]' },
  { label: 'Driver Team & Pit Operation', span: 'aspect-[4/3]' },
  { label: 'Community Outreach & STEM Promotion', span: 'aspect-[4/3]' }
];
---

<BaseLayout>
  {/* ── HERO ──────────────────────────────────────────────────────── */}
  <section class="relative isolate overflow-hidden bg-brand-ink text-white">
    
    {/* MACHINING BACKGROUND VIDEO */}
    <video 
      class="absolute inset-0 h-full w-full object-cover opacity-15 -z-10 pointer-events-none" 
      autoplay 
      loop 
      muted 
      playsinline
    >
      <source src="/video/Manufacturing_and_Machining_Video_Ready.mp4" type="video/mp4" />
    </video>

    <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:py-28 lg:px-8">
      <div>
        <p class="t-eyebrow inline-flex items-center gap-3 text-brand-red">
          <span class="brand-rule"></span>
          Pomperaug High School • FRC Team 2064
        </p>
        <h1 class="t-h1 mt-6 text-6xl text-white sm:text-7xl lg:text-[88px]">
          The Panther
          <span class="block text-brand-red">Project</span>
        </h1>
        <p class="t-subtitle mt-8 max-w-xl text-lg text-white/70 sm:text-xl">
          Welcome to the official home of FRC Team 2064. Based out of Pomperaug High School in Southbury, Connecticut, we empower students through engineering, machining, programming, and STEM leadership.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <M3Button href="/robots/">View Robots</M3Button>
          <M3Button href="/events/" variant="ghost">Upcoming Events</M3Button>
        </div>

        <div class="mt-14 inline-flex items-center gap-4 border-t border-white/10 pt-8">
          <span class="brand-rule"></span>
          <p class="t-h3 text-base text-white/80 sm:text-lg">
            Competing In FIRST Since <span class="text-brand-red">2006</span>
          </p>
        </div>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="relative aspect-square w-full max-w-md overflow-hidden rounded-3xl border border-white/10 bg-brand-ink">
          <img
            src="/brand/logo.png"
            alt="2064 The Panther Project"
            class="relative h-full w-full object-contain p-10"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ── SPONSOR MARQUEE ───────────────────────────────────────────── */}
  <section class="border-y border-black/5 bg-white py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-6">
        <div class="shrink-0">
          <p class="t-eyebrow text-brand-red">Sponsored By</p>
          <p class="t-subscript mt-1 text-black/40">Partners that power our season</p>
        </div>
        <div class="sponsor-marquee-window relative flex-1 overflow-hidden">
          <div class="marquee gap-6">
            {[...sponsors, ...sponsors].map((sponsor, index) => (
              <a
                href="/sponsors/"
                class="sponsor-logo-rail-item shrink-0"
                aria-label={`${sponsor.name} sponsor logo`}
                aria-hidden={index >= sponsors.length ? 'true' : undefined}
                tabindex={index >= sponsors.length ? '-1' : undefined}
              >
                <span class="sponsor-logo-frame sponsor-logo-frame--marquee">
                  <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo-image sponsor-logo-image--muted" loading="lazy" />
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── PILLARS ───────────────────────────────────────────────────── */}
  <section class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="t-eyebrow inline-flex items-center gap-3 text-brand-red">
          <span class="brand-rule"></span>
          What We Do
        </p>
        <h2 class="t-h2 mt-4 text-4xl text-brand-black sm:text-5xl">Building Robots, Developing Students</h2>
        <p class="t-subtitle mt-4 text-lg text-black/60">
          The robot is just the vehicle we use to teach students how to design, collaborate, and execute complex real-world projects.
        </p>
      </div>

      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        {pillars.map((pillar, index) => (
          <article class="group relative overflow-hidden rounded-2xl border border-black/10 bg-brand-bone p-8 transition hover:border-brand-red hover:bg-white">
            <span class="absolute right-6 top-6 t-h2 text-3xl text-black/10 transition group-hover:text-brand-red/25">
              {String(index + 1).padStart(2, '0')}
            </span>
            <p class="t-eyebrow text-brand-red">{pillar.eyebrow}</p>
            <h3 class="t-h3 mt-3 text-2xl text-brand-black">{pillar.title}</h3>
            <p class="t-body mt-3 text-black/65">{pillar.body}</p>
            <span class="brand-rule mt-6 block"></span>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── GALLERY ────────────────────────────────────────────────     */}
  <section class="relative overflow-hidden bg-brand-bone py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
        <div>
          <p class="t-eyebrow inline-flex items-center gap-3 text-brand-red">
            <span class="brand-rule"></span>
            Shop & Build Season
          </p>
          <h2 class="t-h2 mt-4 text-4xl text-brand-black sm:text-5xl">Inside The Panther Lab</h2>
        </div>
        <p class="t-subtitle max-w-md text-black/55">
          From initial CAD sketches in Onshape to final field deployment, take a look at our students in action.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4 lg:grid-rows-2">
        {galleryTiles.map((photo, index) => (
          <div class={`group relative overflow-hidden rounded-2xl border border-black/10 bg-brand-charcoal ${photo.span}`}>
            <div class="flair-iso flair-iso--dim absolute inset-0 opacity-70"></div>
            <div class="relative flex h-full w-full flex-col items-center justify-center gap-2 p-4 text-center">
              <span class="t-eyebrow text-brand-red">Gallery {String(index + 1).padStart(2, '0')}</span>
              <span class="t-subscript text-white/50">{photo.label}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── CTA ───────────────────────────────────────────────────────── */}
  <section class="bg-brand-red py-16 text-white">
    <div class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-4 sm:px-6 lg:flex-row lg:items-center lg:px-8">
      <div class="max-w-2xl">
        <p class="t-eyebrow text-white/70">Get Involved</p>
        <h2 class="t-h2 mt-3 text-4xl text-white sm:text-5xl">Join The Panther Project.</h2>
      </div>
      <div class="flex flex-wrap gap-3">
        <M3Button href="/resources/" variant="surface">Explore Training Hub</M3Button>
        <M3Button href="/sponsors/" variant="ghost">Our Sponsors</M3Button>
      </div>
    </div>
  </section>
</BaseLayout>