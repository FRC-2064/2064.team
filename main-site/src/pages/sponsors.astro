---
import BaseLayout from '../layouts/BaseLayout.astro';
import M3Button from '../components/M3Button.astro';
import { HACK_CLUB_DONATION_URL, SPONSOR_CONTACT_EMAIL, sponsors } from '../data/site';

const tiers = [
  {
    level: 'Platinum Partner',
    range: '$5,000+',
    perks: [
      'Large logo placement prominently displayed on competition robot',
      'Prime logo sizing on team competition banner and pit display',
      'Featured spotlight across team social media channels and website',
      'Invited VIP pit tour and robot demonstration at regional events'
    ]
  },
  {
    level: 'Gold Partner',
    range: '$2,000 - $4,999',
    perks: [
      'Medium logo placement on competition robot and team banner',
      'Logo recognition on the official Team 2064 sponsor page',
      'Social media shoutout during the build and competition season'
    ]
  },
  {
    level: 'Silver Partner',
    range: '$1000 - $1,999',
    perks: [
      'Standard logo placement on the team banner and website',
      'Name recognition in competition pit displays'
    ]
  },
  {
    level: 'Bronze Supporter',
    range: '$100 - $999',
    perks: [
      'Company or individual name listed on our website sponsor page',
      'Our heartfelt gratitude for powering local STEM education'
    ]
  }
];
---

<BaseLayout title="Sponsors & Support | FRC Team 2064 | The Panther Project">
  <section class="relative isolate overflow-hidden bg-brand-ink text-white">
    <div class="flair-iso flair-iso--dim absolute inset-0 opacity-80"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div>
          <p class="t-eyebrow inline-flex items-center gap-3 text-brand-red">
            <span class="brand-rule"></span>
            Back The Team
          </p>
          <h1 class="t-h1 mt-4 text-6xl text-white sm:text-7xl">Our Sponsors</h1>
          <p class="t-subtitle mt-6 max-w-2xl text-lg text-white/65">
            FRC Team 2064 relies heavily on community partnerships, grants, and corporate sponsorships to fund machine parts, raw materials, registration fees, and shop tools for our students at Pomperaug High School.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <M3Button href={`mailto:${SPONSOR_CONTACT_EMAIL}`}>Become a Sponsor</M3Button>
            <M3Button href={HACK_CLUB_DONATION_URL} variant="ghost" target="_blank" rel="noreferrer">
              Donate via Hack Club
            </M3Button>
          </div>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur">
          <p class="t-eyebrow text-brand-red">Direct Contact</p>
          <a href={`mailto:${SPONSOR_CONTACT_EMAIL}`} class="t-h3 mt-3 block break-all text-lg text-white underline decoration-brand-red decoration-2 underline-offset-[6px]">
            {SPONSOR_CONTACT_EMAIL}
          </a>
          <p class="t-subscript mt-4 text-white/55">
            Reach out to discuss corporate matching, in-kind tool donations, or custom partnership opportunities.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Current sponsors ─────────────────────────────────────────── */}
  <section class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 flex items-end justify-between">
        <div>
          <p class="t-eyebrow text-brand-red">Current Sponsors</p>
          <h2 class="t-h2 mt-2 text-3xl text-brand-black sm:text-4xl">Organizations behind the build season</h2>
        </div>
        <span class="t-h3 hidden text-brand-charcoal/30 sm:block">{String(sponsors.length).padStart(2, '0')}</span>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
        {sponsors.map((sponsor) => (
          <article class="sponsor-logo-card sponsor-logo-card--page h-32 w-full sm:h-36">
            <span class="sponsor-logo-frame sponsor-logo-frame--page">
              <img src={sponsor.logo} alt={`${sponsor.name} logo`} class="sponsor-logo-image" loading="lazy" />
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── Tiers ───────────────────────────────────────────────────── */}
  <section class="bg-brand-bone py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-2xl">
        <p class="t-eyebrow text-brand-red">Support Levels</p>
        <h2 class="t-h2 mt-2 text-3xl text-brand-black sm:text-4xl">Partnership Tiers</h2>
        <p class="t-subtitle mt-4 text-black/65">Invest in the next generation of engineers, machinists, and problem solvers at Pomperaug High School.</p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {tiers.map((tier, index) => {
          const featured = index === 0;
          return (
            <article class:list={[
              'relative flex flex-col gap-5 overflow-hidden rounded-2xl border p-6 transition',
              featured
                ? 'border-transparent bg-brand-ink text-white'
                : 'border-black/10 bg-white hover:border-brand-red'
            ]}>
              {featured && <div class="flair-iso flair-iso--dim absolute inset-0 opacity-50"></div>}
              <div class="relative">
                <p class="t-eyebrow text-brand-red">
                  Tier {String(index + 1).padStart(2, '0')}
                </p>
                <h3 class:list={['t-h2 mt-3 text-2xl', featured ? 'text-white' : 'text-brand-black']}>
                  {tier.level}
                </h3>
                <p class:list={['t-h3 mt-1 text-base', featured ? 'text-brand-red' : 'text-brand-charcoal']}>{tier.range}</p>
              </div>
              <ul class:list={['relative flex flex-col gap-2.5 text-sm', featured ? 'text-white/75' : 'text-black/65']}>
                {tier.perks.map((perk) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-1 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-brand-red"></span>
                    <span>{perk}</span>
                  </li>
                ))}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</BaseLayout>